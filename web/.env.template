# ──────────────────────────────────────────────────────────────
# 环境变量模板
#
# 使用方式：
#   cp .env.template .env
#   然后按下方说明填入真实值
#
# ⚠️ 不要把填好的 .env 提交到仓库。.env 已在 .gitignore 中忽略。
# ──────────────────────────────────────────────────────────────

# ── MongoDB ──────────────────────────────────────────────────
MONGO_PORT=27017
MONGO_INITDB_ROOT_USERNAME=your_mongo_username
MONGO_INITDB_ROOT_PASSWORD=your_mongo_password
MONGO_INITDB_DATABASE=buct-course

# ── 后端应用 ─────────────────────────────────────────────────
GO_PORT=5000
# JWT 签名密钥：生产环境务必改为随机长字符串
SECRET_KEY=change-this-in-production

# ── 邮件（必填，否则验证码与提醒邮件不可用）────────────────────
MAIL_SMTP_SERVER=smtp.163.com
MAIL_SMTP_PORT=465
MAIL_SENDER=your_email@163.com
# 注意是邮箱「授权码」，不是登录密码
MAIL_PASSWORD=your_email_auth_code
VERIFY_CODE_EXPIRE=180

# ── AES 密钥（可选）──────────────────────────────────────────
# 用于 /api/crypto 的对称加解密。未设置时该功能静默关闭（enabled=false）。
# 任意长度字符串，内部会做 SHA-256 派生 32 字节密钥。
# 生成：openssl rand -hex 32
AES_KEY=your_aes_key

# ── ECC 密钥（必填）──────────────────────────────────────────
# 用于加密存储学生的学校密码。生成方式见 README「ECC 密钥生成」。
#
# ⚠️ 更换密钥会导致库中已加密的 s_password 无法解密，
#    必须同步执行数据迁移，否则用户的自动抓取会全部失败。
ECC_PRIVATE_KEY=your_p256_private_key_decimal
ECC_PUBLIC_KEY=your_p256_public_key_x_decimal

# ── RSA（防爬虫请求加密）─────────────────────────────────────
RSA_KEY_SIZE=2048
RSA_KEY_EXPIRE_MINUTES=30
RSA_ENABLE=true

# ── Snowflake ID 生成器 ──────────────────────────────────────
# 多实例部署时每个实例需设不同值，否则会生成重复 ID。
# 注意：当前代码尚未读取此变量（硬编码为 1），见 README「已知问题」。
SNOWFLAKE_NODE=1

# ── 前端 / Nginx ─────────────────────────────────────────────
FRONTEND_PORT=3033
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ── 其他 ─────────────────────────────────────────────────────
# true: 强制测试模式，验证码直接返回而不发邮件
TEST_MODE=false
